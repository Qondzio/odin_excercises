<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <link rel="icon" type="image/x-icon" href="../images/Fortnite_S1.webp">
    <title>Fortnite weapons</title>
</head>
<body>
    <main>
        <header>
            <a href="/"><img src="/images/back.png" alt="back" width="40px" height="40px"></a>
            <h1>Fortnite weapons</h1>
        </header>
        <table>
            <tr>
                <th>

                </th>
                <th>
                    Weapon name
                </th>
                <th>
                    Rarity
                </th>
                <th>
                    Description
                </th>
            </tr>
            <% weapons.map(weapon=>{ %>
                <tr>
                    <td>
                        <img src="<%=weapon.imageurl || '/images/' + weapon.name + '.png' %>" alt="<%= weapon.name %>" style="background-color: <%=weapon.color %>;">
                    </td>
                    <td>
                        <%= weapon.name %>
                    </td>
                    <td style="color: <%= weapon.color %>;">
                        <%= weapon.rarity %>
                    </td>
                    <td>
                        <%= weapon.description %>
                    </td>
                    <td>
                        <form action="/delete/<%=weapon.id %>" method="post" id="deleteWeapon<%=weapon.id %>">
                            <button type="button" class="delete_weapon" onclick="if(confirm('Are you sure you want to delete that?')) {document.getElementById('deleteWeapon<%=weapon.id %>').submit();}">X</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </table>
        <a href="/addWeapon/<%=weaponType %>">
            <div class="add">+</div>
        </a>
    </main>
</body>
