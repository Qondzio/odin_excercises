<head>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <% messages.forEach((message,index)=>{ %>
    <div class="message_div">
    
        <p>Message: <%=message.text %></p>
        <p>Sent by: <%=message.user %></p>
        <p>Added on: <%=message.added %></p>
        <button onclick="window.location.href='/message/<%= index %>'">View message</button>
    </div>
    <% }) %>
    <h1><a href="/new">Add a new message!</a></h1>
</div>
</body>