<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="style.css">
    <title>SECRET ADMIN</title>
</head>
<body>
    <% if(locals.user) {%>
        <div class="admin">
            <h1>Enter secret code to become admin</h1>
            <form action="/secretAdmin" method="post">
                <input type="code" name="code" id="code">
                <button type="submit">Become admin</button>
            </form>
        </div>
    <% } else{ %>
        <div class="admin">
            <h1>You must first log-in to the website</h1>
            <button onclick=window.location.href='/sign-in'>Proceed to the log-in page</button>
        </div>
    <% } %>
</body>
</html>