<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="style.css">
    <title>Messages</title>
</head>
<body>
    <h1>Messages</h1>
    <div class="messages">
        <% if(locals.user){
            locals.messages.map((message) =>{ %>
            <div class="message">
                <span>User: <%=message.username %></span>
                <span>Date added: <%=message.creation_date %></span>
                <span>Message: <%=message.message %></span>
                <% if(locals.user.role === 'admin') {%>
                    <button style="background-color:lightcoral;">Delete message</button>
                <% }%>                    
            </div>
        <% })
        } else{ locals.messages.map((message) =>{%>
            <div class="message">
                <span>User: Anonymous</span>
                <span>Message: <%=message.message %></span>
            </div>
        <% })} %>
    </div>
    <button onclick=window.location.href='/addMessage'>Add message</button>
</body>
</html>